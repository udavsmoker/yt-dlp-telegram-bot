# Telegram Bot Configuration
BOT_TOKEN=your_bot_token_here
# Optional: Set to your local telegram-bot-api server for 2000MB uploads
BOT_API_URL=http://localhost:8081

# Environment
NODE_ENV=development

# Download settings
# Set to 2000 if using local telegram-bot-api, or 50 for official API
MAX_FILE_SIZE=2000
TEMP_DIR=./temp
# Optional: Path to Netscape cookies.txt file for restricted/age-gated media
# YTDLP_COOKIES_FILE=./cookies.txt

# Admin
ADMIN_USER_ID=your_admin_user_id_here

# Cache settings (SQLite WAL mode)
ENABLE_VIDEO_CACHE=true
CACHE_TTL_HOURS=48
# Retention for audio tracks (Spotify / YouTube Music / Search): 30 days
CACHE_AUDIO_TTL_DAYS=30

# Queue settings
DOWNLOAD_CONCURRENCY=4

# Rate limiting
RATE_LIMIT_ENABLED=true
RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_MAX_REQUESTS=30
DOWNLOAD_RATE_LIMIT_MAX=5

# Spotify Pipeline settings
# Client ID/Secret are optional; the bot uses anonymous token exchange & Pathfinder GraphQL automatically
# SPOTIFY_CLIENT_ID=your_spotify_client_id
# SPOTIFY_CLIENT_SECRET=your_spotify_client_secret
SPOTIFY_MAX_TRACKS=1000
SPOTIFY_CONCURRENCY=3



